{
  "$schema": "https://unpkg.com/opencode-swarm/opencode-swarm.schema.json",
  "authority": {
    "enabled": true,
    "rules": {
      "documentador": {
        "readOnly": false,
        "allowedPrefix": ["docs/", "indie-now/docs/"],
        "allowedGlobs": ["docs/**", "indie-now/docs/**"],
        "blockedPrefix": [".swarm/", "src/", "indie-now/src/", "specs/", "indie-now/specs/", "node_modules/"]
      }
    }
  }
}
